// kmir harness — generated by testsuite runner
//
// kmir run --bin __ts_harness <crate-root>
//
// kmir ingests the crate via `cargo build` with RUSTC=stable-mir-json,
// producing Stable MIR JSON, then executes it through K semantics.
// The start symbol defaults to `main`; kmir_probe_entry is called from main.
//
// Plain `fn main()` is required: kmir run looks for a binary target and
// enters at `main` by default (--start-symbol overrides this).

fn main() {
    {{ target_crate_name }}::{{ entry_fn }}();
}
